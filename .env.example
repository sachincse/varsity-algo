# ---------------------------------------------------------------------------
# Copy this file to  .env  and fill in what you need.
# Nothing here is required to run the scanner on free end-of-day data.
# ---------------------------------------------------------------------------

# --- price source -----------------------------------------------------------
# Leave BLANK to choose automatically: Kite when you are logged in (matching
# the video, and matching your broker's own chart), the free Yahoo feed when
# you are not. Set explicitly to "kite" or "yfinance" to force one.
PRICE_SOURCE=

# --- Zerodha Kite Connect ---------------------------------------------------
# Only needed for holdings, live prices and placing orders.
# Create an app at https://developers.kite.trade  (Connect type, Rs 500/month)
# Redirect URL:  http://127.0.0.1:8000/kite-redirect
KITE_API_KEY=
KITE_API_SECRET=

# --- order placement --------------------------------------------------------
# Leave false unless you genuinely intend to send real orders.
# Even when true, every order needs a preview token and a confirmation.
ENABLE_TRADING=false

# --- language model ---------------------------------------------------------
# Optional. Only used to turn English into a strategy. Pick ONE provider.
# The Setup tab in the app lists every option and whether it is ready.
#
#   free, no card:   groq | gemini | openrouter
#   local, no key:   ollama | lmstudio
#   paid:            anthropic | deepseek | together | fireworks | cerebras
#                    | mistral | xai
#   your own:        custom  (also set LLM_BASE_URL)
LLM_PROVIDER=ollama

# Override the provider's default model. Model IDs change often — if you get
# "provider does not know this model", check the provider's model list.
LLM_MODEL=qwen3:8b

# Only one of these is needed, matching LLM_PROVIDER above.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
FIREWORKS_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=
XAI_API_KEY=

# For LLM_PROVIDER=custom (vLLM, llama.cpp, LiteLLM proxy, company gateway)
LLM_BASE_URL=
LLM_API_KEY=

# --- misc -------------------------------------------------------------------
LOG_LEVEL=INFO
PANEL_CACHE_SECONDS=600
